{
    "name": "Net Defender",
    "version": "1.0.0",
    "manifest_version": 3,
    "description": "無意識に長時間ネットサーフィンや動画視聴を続けてしまうことを防ぎます。",
    "action": {
        "default_title": "Net Defender の設定を開く"
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background/service_worker.js",
        "type": "module"
    },
    "permissions": [
        "storage",
        "scripting"
    ],
    "optional_host_permissions": [
        "*://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "shared/constants.js",
                "shared/domain.js",
                "content/content.html",
                "content/content.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
